@model FMS_ICS.Models.Purchase

@{
    ViewBag.Title = "Edit Purchase";
}

<h2 style="color: #77aded; font-weight: bold;">Edit Purchase</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.PurchaseID)
    @Html.HiddenFor(model => model.PurchaseDate)

    <div class="form-horizontal" style="background: linear-gradient(90deg, #77aded, #d6bb29); padding: 20px; border-radius: 10px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.PurchaseDate, new { @class = "control-label col-md-2" })
            @*<div class="col-md-10" style="color: #d6bb29; font-weight: bold;">
                @Html.DisplayFor(model => model.PurchaseDate)
            </div>*@
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.UserID, "User", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("UserID", null, new { @class = "form-control", style = "border: 2px solid #77aded; border-radius: 5px;" })
                @Html.ValidationMessageFor(model => model.UserID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ProductID, "Product", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("ProductID", null, new { @class = "form-control", style = "border: 2px solid #77aded; border-radius: 5px;" })
                @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.TotalAmount, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.TotalAmount, new { htmlAttributes = new { @class = "form-control", style = "border: 2px solid #77aded; border-radius: 5px;" } })
                @Html.ValidationMessageFor(model => model.TotalAmount, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.TenureMonths, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.TenureMonths,
                    new SelectList(new[] { 3, 6, 9, 12 }),
                    new { @class = "form-control", style = "border: 2px solid #77aded; border-radius: 5px;" })
                @Html.ValidationMessageFor(model => model.TenureMonths, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MonthlyEMI, new { @class = "control-label col-md-2" })
            <div class="col-md-10" style="color: #d6bb29; font-weight: bold;">
                @Html.DisplayFor(model => model.MonthlyEMI)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-success" style="background-color: #77aded; border: none; border-radius: 5px; padding: 10px 20px;" />
            </div>
        </div>
    </div>
}

<div style="margin-top: 20px;">
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-warning", style = "background-color: #d6bb29; border: none; border-radius: 5px; padding: 10px 20px; color: white; text-decoration: none;" })
</div>
